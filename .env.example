# ---------------------------------------------------------------------------
# Copy to .env.local for local development.
# In production set these in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Canonical site origin. No trailing slash. Used for canonical tags, the
# sitemap, RSS and every JSON-LD @id — getting it wrong is a real SEO cost.
NEXT_PUBLIC_SITE_URL=https://infernoemails.com

# Neon Postgres. Vercel injects this automatically once you add the Neon
# integration (Storage → Create Database → Neon). Pull it locally with:
#   vercel env pull .env.local
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# CMS password for /admin. REQUIRED — there is no built-in default.
# Use something long and random; anyone with this can publish to your site.
BLOG_ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. If unset, the admin password is
# used as the signing key. Set this if you want to rotate the password
# without invalidating sessions, or vice versa.
BLOG_AUTH_SECRET=

# Vercel Blob, for images uploaded through the CMS. Injected automatically
# once you add a Blob store (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 Measurement ID (Admin → Data Streams → your web stream).
# Optional — GA only loads when this is set.
NEXT_PUBLIC_GA_ID=
